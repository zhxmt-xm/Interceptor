{
  "name": "@interceptor/platform-capabilities",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "Shared native platform capabilities for Interceptor",
  "type": "commonjs",
  "main": "src/entry.ts",
  "types": "src/entry.ts",
  "exports": {
    ".": {
      "types": "./src/entry.ts",
      "default": "./src/entry.ts"
    },
    "./client-app": {
      "types": "./src/client-app/entry.ts",
      "default": "./src/client-app/entry.ts"
    },
    "./*": {
      "types": "./src/*.ts",
      "default": "./src/*.ts"
    }
  },
  "scripts": {
    "build:native": "node src/system-proxy/windows/build-helper.mjs && node src/app-container/windows/build-windows-helper.mjs && node src/helper/macos/native/build-helper.mjs && node src/client-app/windows/build-client-app-helper.mjs",
    "test": "vitest run",
    "typecheck": "tsc --project tsconfig.json --noEmit"
  },
  "dependencies": {
    "@interceptor/core-protocol": "0.0.0",
    "@interceptor/tools": "0.0.0",
    "@peculiar/x509": "2.1.0",
    "@vscode/sudo-prompt": "9.3.2",
    "reflect-metadata": "0.2.2"
  },
  "devDependencies": {
    "vitest": "5.0.3"
  }
}