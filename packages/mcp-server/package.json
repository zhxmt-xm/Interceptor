{
  "name": "@interceptor/mcp-server",
  "version": "0.0.0",
  "private": true,
  "description": "Transport-agnostic MCP tool layer exposing Interceptor capture data to external AI hosts",
  "type": "commonjs",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc --project tsconfig.json --noEmit"
  },
  "dependencies": {
    "@interceptor/core-protocol": "*",
    "@interceptor/tools": "*"
  },
  "devDependencies": {
    "vitest": "4.1.10"
  }
}
