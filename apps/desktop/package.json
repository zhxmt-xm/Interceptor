{
  "name": "@interceptor/desktop",
  "productName": "Interceptor",
  "version": "0.1.1-alpha.1",
  "private": true,
  "license": "Apache-2.0",
  "author": "zhxmt-xm",
  "description": "Interceptor Electron desktop application",
  "main": ".vite/build/main.cjs",
  "scripts": {
    "build:native": "npm run build:native --workspace @interceptor/platform-capabilities",
    "e2e:prepare-local": "npm run build --workspace @interceptor/core-protocol && npm run build --workspace @interceptor/proxy-core && npm run build:native && node tests/e2e-workflow-tests/prepare-local.mjs",
    "prepare:android-runtime": "node ../../scripts/prepare-android-runtime.mjs",
    "package": "npm run build:native && npm run prepare:android-runtime && electron-forge package",
    "make": "npm run build:native && npm run prepare:android-runtime && electron-forge make",
    "start": "npm run build:native && electron-forge start",
    "test": "vitest run",
    "test:installer:windows": "node --experimental-transform-types tests/installer/windows-installer-smoke.mjs",
    "test:package-audit": "node tests/installer/package-artifact-audit.mjs",
    "test:e2e:workflow": "node tests/e2e-workflow-tests/run.mjs",
    "test:demo:workflow": "node tests/demo-workflow-tests/run.mjs",
    "test:e2e:workflow:report": "playwright show-report playwright-report/e2e-workflow-tests",
    "test:release:macos": "node tests/installer/macos-release-smoke.mjs",
    "test:smoke": "playwright test",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ant-design/icons": "6.3.4",
    "@fontsource-variable/ibm-plex-sans": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/noto-sans-sc": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@interceptor/agent-runtime": "0.0.0",
    "@interceptor/core-protocol": "0.0.0",
    "@interceptor/mcp-server": "0.0.0",
    "@interceptor/platform-capabilities": "0.0.0",
    "@interceptor/tools": "0.0.0",
    "@modelcontextprotocol/node": "2.1.1",
    "@peculiar/x509": "2.1.0",
    "@tanstack/react-table": "9.2.8",
    "@tanstack/react-virtual": "3.14.14",
    "@vscode/sudo-prompt": "9.3.2",
    "antd": "6.6.5",
    "i18next": "26.4.3",
    "lucide-react": "1.55.0",
    "monaco-editor": "0.57.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "17.0.16",
    "react-markdown": "10.1.0",
    "reflect-metadata": "0.2.2",
    "remark-gfm": "4.0.1",
    "semver": "7.8.5",
    "simple-icons": "16.34.0",
    "xml-formatter": "3.7.0",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@electron-forge/cli": "8.0.1",
    "@electron-forge/maker-dmg": "8.0.1",
    "@electron-forge/maker-wix": "8.0.1",
    "@electron-forge/maker-zip": "8.0.1",
    "@electron-forge/plugin-vite": "8.0.1",
    "@electron-forge/shared-types": "8.0.1",
    "@electron/asar": "4.3.1",
    "@electron/fuses": "2.1.3",
    "@ffmpeg-installer/ffmpeg": "1.1.0",
    "@modelcontextprotocol/client": "2.3.1",
    "@modelcontextprotocol/core": "2.3.1",
    "@playwright/test": "1.64.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/semver": "7.8.0",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.7.0",
    "extract-zip": "2.0.1",
    "sharp": "0.35.5",
    "vite": "8.3.4",
    "vitest": "5.0.3",
    "ws": "8.22.0"
  }
}
