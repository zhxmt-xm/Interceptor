{
  "name": "@interceptor/desktop",
  "productName": "Interceptor",
  "version": "0.1.0",
  "private": true,
  "author": "zhxmt-xm",
  "description": "Interceptor Electron desktop application",
  "main": ".vite/build/main.js",
  "scripts": {
    "build:native": "node src/main/system-proxy/build-windows-helper.mjs && node src/main/system-proxy/build-macos-helper.mjs",
    "package": "npm run build:native && electron-forge package",
    "make": "npm run build:native && electron-forge make",
    "start": "npm run build:native && electron-forge start",
    "test": "vitest run",
    "test:installer:windows": "node tests/installer/windows-installer-smoke.mjs",
    "test:package-audit": "node tests/installer/package-artifact-audit.mjs",
    "test:release:macos": "node tests/installer/macos-release-smoke.mjs",
    "test:smoke": "playwright test",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ant-design/icons": "6.3.2",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/state": "6.7.1",
    "@codemirror/view": "6.43.6",
    "@fontsource-variable/ibm-plex-sans": "5.2.8",
    "@fontsource-variable/inter": "5.2.8",
    "@fontsource-variable/jetbrains-mono": "5.2.8",
    "@fontsource/ibm-plex-mono": "5.2.7",
    "@interceptor/core-protocol": "0.0.0",
    "@peculiar/x509": "2.0.0",
    "@tanstack/react-table": "8.21.3",
    "@tanstack/react-virtual": "3.14.6",
    "@uiw/react-codemirror": "4.25.11",
    "@vscode/sudo-prompt": "9.3.2",
    "antd": "6.5.0",
    "i18next": "26.3.6",
    "lucide-react": "1.23.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-i18next": "17.0.10",
    "reflect-metadata": "0.2.2",
    "semver": "7.7.3",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/maker-dmg": "7.11.2",
    "@electron-forge/maker-wix": "7.11.2",
    "@electron-forge/maker-zip": "7.11.2",
    "@electron-forge/plugin-vite": "7.11.2",
    "@electron-forge/shared-types": "7.11.2",
    "@electron/asar": "3.4.1",
    "@electron/fuses": "2.1.3",
    "@playwright/test": "1.61.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/semver": "7.7.1",
    "@vitejs/plugin-react": "6.0.3",
    "electron": "43.1.0",
    "pixelmatch": "7.2.0",
    "pngjs": "7.0.0",
    "vite": "8.1.4",
    "vitest": "4.1.10"
  }
}
