{
  "name": "@interceptor/proxy-core",
  "version": "0.0.0",
  "private": true,
  "description": "Interceptor proxy core process",
  "type": "commonjs",
  "main": "dist/proxy-core/core-entry.cjs",
  "scripts": {
    "build": "npm run clean && esbuild src/proxy-core/core-entry.cts --bundle --platform=node --format=cjs --target=node24 --outfile=dist/proxy-core/core-entry.cjs --sourcemap",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "test": "vitest run",
    "typecheck": "tsc --project tsconfig.json --noEmit"
  },
  "dependencies": {
    "@interceptor/core-protocol": "0.0.0"
  },
  "devDependencies": {
    "esbuild": "0.27.0",
    "vitest": "4.1.10"
  }
}