{
  "name": "interceptor",
  "version": "0.0.0",
  "private": true,
  "description": "Cross-platform desktop HTTP debugging proxy",
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": ">=24.18.0 <25",
    "npm": ">=11.16.0 <12"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "design-vite"
  ],
  "scripts": {
    "postinstall": "patch-package",
    "playground": "npm run dev --workspace @interceptor/playground",
    "build:core": "npm run build --workspace @interceptor/core-protocol && npm run build --workspace @interceptor/proxy-core",
    "dev": "npm run build:core && npm run start --workspace @interceptor/desktop",
    "package": "npm run build:core && npm run package --workspace @interceptor/desktop",
    "make": "npm run build:core && npm run make --workspace @interceptor/desktop",
    "test": "npm run test:unit",
    "test:e2e:workflow": "npm run test:e2e:workflow --workspace @interceptor/desktop",
    "test:smoke": "npm run package && npm run test:smoke --workspace @interceptor/desktop",
    "test:installer:windows": "npm run test:installer:windows --workspace @interceptor/desktop",
    "test:package-audit": "npm run test:package-audit --workspace @interceptor/desktop",
    "test:release:macos": "npm run test:release:macos --workspace @interceptor/desktop",
    "test:unit": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "overrides": {
    "monaco-editor": {
      "dompurify": "3.4.13"
    },
    "socks": {
      "ip-address": "10.3.1"
    }
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "patch-package": "8.0.1",
    "typescript": "7.0.2"
  }
}
